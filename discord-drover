#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Find libdrover.so
LIBDROVER=""
if [ -f "$SCRIPT_DIR/libdrover.so" ]; then
    LIBDROVER="$SCRIPT_DIR/libdrover.so"
elif [ -f "$HOME/.local/lib/discord-drover/libdrover.so" ]; then
    LIBDROVER="$HOME/.local/lib/discord-drover/libdrover.so"
elif [ -f "/usr/local/lib/libdrover.so" ]; then
    LIBDROVER="/usr/local/lib/libdrover.so"
fi

if [ -z "$LIBDROVER" ]; then
    echo "[-] Error: libdrover.so not found. Running make to compile it..." >&2
    make -C "$SCRIPT_DIR"
    LIBDROVER="$SCRIPT_DIR/libdrover.so"
fi

# Locate config directory
CONFIG_DIR="$HOME/.config/discord"
mkdir -p "$CONFIG_DIR"

if [ ! -f "$CONFIG_DIR/drover.ini" ]; then
    cat << 'EOF' > "$CONFIG_DIR/drover.ini"
[drover]
proxy = http://127.0.0.1:9080
EOF
fi

if [ ! -f "$CONFIG_DIR/drover-packet.bin" ] && [ -f "$SCRIPT_DIR/drover-packet.bin" ]; then
    cp "$SCRIPT_DIR/drover-packet.bin" "$CONFIG_DIR/drover-packet.bin"
fi

export DROVER_CONFIG_DIR="$CONFIG_DIR"

# Parse proxy parameter from drover.ini if set
PROXY_ARG=""
BYPASS_ARG=""
if [ -f "$CONFIG_DIR/drover.ini" ]; then
    RAW_PROXY=$(grep -E '^[[:space:]]*proxy[[:space:]]*=' "$CONFIG_DIR/drover.ini" | head -n1 | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$RAW_PROXY" ]; then
        PROXY_ARG="--proxy-server=$RAW_PROXY"
        # Bypassa servidores de upload CloudUpload (Google Cloud Storage), CDNs e mídias do Discord
        BYPASS_ARG="--proxy-bypass-list=*.storage.googleapis.com,*.googleapis.com,*.discordapp.com,*.discordapp.net,*.discord.media,*.gcp.discord.gg"
    fi
fi

# Auto-start Tor with HTTP tunnel on 9080 if not running
if [[ "$RAW_PROXY" =~ 9080|9050 ]]; then
    PORT_TO_CHECK=9080
    if [[ "$RAW_PROXY" =~ 9050 ]] && [[ ! "$RAW_PROXY" =~ 9080 ]]; then
        PORT_TO_CHECK=9050
    fi
    if ! (echo > /dev/tcp/127.0.0.1/$PORT_TO_CHECK) 2>/dev/null; then
        echo "[*] Iniciando serviço do Tor em segundo plano..."
        if command -v tor >/dev/null 2>&1; then
            mkdir -p "$HOME/.local/share/tor"
            tor --SocksPort 0 --HTTPTunnelPort 9080 --DataDirectory "$HOME/.local/share/tor" --RunAsDaemon 1 >/dev/null 2>&1 || true
            for i in {1..12}; do
                if (echo > /dev/tcp/127.0.0.1/$PORT_TO_CHECK) 2>/dev/null; then
                    echo "[+] Tor conectado e pronto na porta $PORT_TO_CHECK!"
                    break
                fi
                sleep 0.5
            done
        else
            echo "[!] Tor não encontrado no sistema. Por favor instale com: sudo apt install tor" >&2
        fi
    fi
fi

# Locate Discord executable
DISCORD_BIN=""
if [ -n "$DISCORD_EXEC" ] && command -v "$DISCORD_EXEC" >/dev/null 2>&1; then
    DISCORD_BIN="$DISCORD_EXEC"
elif [ -x "$HOME/.config/discord/Discord" ]; then
    DISCORD_BIN="$HOME/.config/discord/Discord"
elif command -v discord >/dev/null 2>&1; then
    DISCORD_BIN="$(command -v discord)"
elif command -v discord-canary >/dev/null 2>&1; then
    DISCORD_BIN="$(command -v discord-canary)"
elif command -v discord-ptb >/dev/null 2>&1; then
    DISCORD_BIN="$(command -v discord-ptb)"
elif [ -x "/usr/share/discord/Discord" ]; then
    DISCORD_BIN="/usr/share/discord/Discord"
elif [ -x "/opt/discord/Discord" ]; then
    DISCORD_BIN="/opt/discord/Discord"
fi

if [ -z "$DISCORD_BIN" ]; then
    echo "[-] Error: Discord executable not found." >&2
    exit 1
fi

echo "[+] Abrindo Discord com Drover (Uploads e CloudStorage em velocidade máxima)..."
export LD_PRELOAD="$LIBDROVER${LD_PRELOAD:+:$LD_PRELOAD}"

if [ -n "$PROXY_ARG" ]; then
    exec "$DISCORD_BIN" "$PROXY_ARG" "$BYPASS_ARG" "$@"
else
    exec "$DISCORD_BIN" "$@"
fi
